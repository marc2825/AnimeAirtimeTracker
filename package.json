{
  "name": "anime-airtime-tracker",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:fixtures": "tsx scripts/import-fixtures.ts",
    "ingest": "tsx scripts/ingest.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fast-xml-parser": "^5.12.1",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.22.1"
    }
  }
}
