# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
# Full reference: docs/operations.md#environment-variables
# ---------------------------------------------------------------------------

# PostgreSQL. `npm run db:local` starts an embedded PostgreSQL 18 on port 54320.
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/anime_airtime_tracker"

# Separate database for `npm run test:db` (tables are truncated by the tests).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54320/anime_airtime_tracker_test"

# Public origin used for canonical URLs, sitemap.xml and Open Graph.
SITE_URL="http://localhost:3000"

# Required only for live ingestion from Syoboi Calendar.
# Format required by https://docs.cal.syoboi.jp/rule/bot/ : AppName/version (+URL of a page with contact info)
SYOBOI_USER_AGENT=""

# Wait after each Syoboi response before the next request, in ms. Values below 1000 are rejected.
SYOBOI_MIN_INTERVAL_MS="3000"
